# Runtime output
backups/*
dist/*
logs/*
*.log
*.lock
restore-serv-rollback-*.sh

# Keep project directories visible
!backups/.gitkeep
!dist/.gitkeep
!logs/.gitkeep

# Local settings and secrets
.env
.env.*
*.local
*.secret

# Temporary files
*.tmp
*.swp
*.swo
*~

# OS/editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/

# Archives generated by backup scripts
*.tar
*.tar.gz
*.tgz
*.tar.zst
*.zip
